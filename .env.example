# --- Firebase (Web app) — preferência para listar histórias em stories_public ---
# Console: Firebase → Definições do projeto → As tuas apps → Web
VITE_FIREBASE_API_KEY= 
VITE_FIREBASE_AUTH_DOMAIN= 
VITE_FIREBASE_PROJECT_ID= "
VITE_FIREBASE_STORAGE_BUCKET= 
VITE_FIREBASE_MESSAGING_SENDER_ID= 
VITE_FIREBASE_APP_ID= 

# Região das Cloud Functions (opcional; predefinido: europe-west1)
VITE_FIREBASE_FUNCTIONS_REGION=

# Alternativa: URL GET com JSON (array ou { "stories": [...] }) — usada só se Firebase não estiver configurado
VITE_PUBLIC_STORIES_URL=
